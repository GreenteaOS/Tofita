@struct @sizeOf(8 * 4 + 4)
class Timer {
	var hwnd UInt64 // Window handle
	var nIDEvent UInt64 // Timer ID
	var interval UInt64 // Interval in milliseconds
	var nextFireTime UInt64 // Next firing time (uptimeMilliseconds)
	var timerProc UInt64 // TIMERPROC function pointer (0 if NULL)
	var processId UInt64 // Process ID TODO use reference not ID index
	new () { }
}

var timerList [Timer] = [] // Array to store up to 256 timers
var timerListUsed UInt64 = 0 // Number of timers in use
