{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "(gdb) localhost:1234",
			"type": "cppdbg",
			"request": "launch",
			"program": "C:\\Tea\\tofita.exe",
			"miDebuggerServerAddress": "localhost:1234",
			"cwd": "${workspaceFolder}",
			"MIMode": "gdb",
			"setupCommands": [
				{
					"description": "Pretty gdb",
					"text": "-enable-pretty-printing",
					"ignoreFailures": true
				}
			]
		},
		{
			"type": "lldb-mi",
			"request": "attach",
			"name": "QEMU LLDB",
			"target": "localhost:1234",
			"cwd": "${workspaceRoot}",
			"valuesFormatting": "parseText",
			"executable": "C:\\Tea\\tofita.exe"
		},
		{
			"name": "QEMU GDB",
			"type": "gdb",
			"request": "attach",
			"cwd": "${workspaceRoot}",
			"target": "localhost:1234",
			"gdbpath": "gdb.exe",
			"remote": true,
			"executable": "C:\\Tea\\tofita.exe",
			"valuesFormatting": "parseText"
		}
	]
}
