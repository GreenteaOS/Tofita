// TODO Hexa: if this is not within a separate module, then only one `<T>` instance is generated,
// seemingly it either does it once or just thinks that `<UInt64> == <UInt32>` same instances and deduplicates
class Executable<SIZE, TIB, PEB> {
	var nextBase UInt64
	var pml4 ArrayPointer<ByValue<PageEntry>>
	var startup ProcessStartupInformation
	var teb TIB
	var peb PEB
	var ldr PEB_LDR_DATA<SIZE>
	new () { }
}
