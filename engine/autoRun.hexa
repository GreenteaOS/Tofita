fun autoRun() Void {
	serialPrintln("<Tofita> [autoRun] Auto run startup apps")
	var safeMode = false // TODO
	var safeMode = true // TODO no crash when exes not present
	disableSerial = 1

	if not safeMode {
		for i in 5 {
			if i == 0 {
				continue
			}
			if i == 3 {
				continue
			}

			let guiProcess TofitaProcess = processCreate() // TODO just `new` and no `@struct`
			serialPrintf("<Tofita> GUI process ID == %u\n", guiProcess.pid)
			processInit(guiProcess)
			disableSerial = 1
			// disableSerial = 0

			// TODO `@defer disableSerial = 0` <- `@` must have the lowest priority?
			if i == 1 {
				continue
				loadExeIntoProcess("desktop/demo32.exe", guiProcess)
				guiProcess.name = "demo32.exe"
			}

			if i == 2 {
				loadExeIntoProcess("desktop/demo64.exe", guiProcess)
				guiProcess.name = "demo64.exe"
			}

			if i == 3 {
				continue
				// continue
				loadExeIntoProcess("desktop/calc64.exe", guiProcess)
				guiProcess.name = "calc64.exe"
			}

			if i == 4 {
				loadExeIntoProcess("desktop/sol64.exe", guiProcess)
				// loadExeIntoProcess("desktop/calc32.exe", guiProcess)
				// guiProcess.name = "calc32.exe"
				guiProcess.name = "sol64.exe"
			}

			// disableSerial = 0
			disableSerial = 1
			// TODO loadExeIntoProcess(""root/Windows/GreenteaGUI.exe", guiProcess)
			// TODO guiProcess.name = "Greentea OS GUI"
			guiProcess.schedulable = true
		}
	}
}
