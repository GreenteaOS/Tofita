// Loads EXE and DLL files

// TODO ntdll should have tofitaStub(){} for unresolved dll imports -> log them
// TODO ^ should actually show a message box and abort in future

// TODO use std offset
fun offsetPointer(data UInt64, offset UInt64) ArrayPointer<UInt8> {
	return (data + offset) as! ArrayPointer<UInt8>
}

// TODO why not IMAGE_DATA_DIRECTORY
@struct
class ImageDataDirectory {
	var virtualAddress UInt32
	var size UInt32
}

@struct
class PeInterim {
	/// Base address after relocation
	var base UInt64 // TODO UserPointer?
	/// `_DllMainCRTStartup`
	var entry UInt64
	var imageDataDirectory ArrayPointer<ByValue<ImageDataDirectory>>
	var sizeOfStackReserve UInt64
	var is64bit Bool
	/// Like `kernel32.dll`
	var baseName String
	/// Like `C:\Windows\System32\kernel32.dll`
	var fullName String
	new () { }
}

@struct
class ExeInterim {
	var pei PeInterim
	var stackVirtual UInt64
	new () { }
}

@struct
class PeExportLinkedList {
	var name ConstArrayPointer<UInt8>
	var ptr UInt64
	var next PeExportLinkedList
	var hash UInt8
}

// TODO
/// Optimal use as by-value to avoid allocation
/// Works only with a user space memory
// TODO document this ALL UPPER CASE convention for generics (no scalable?)
@struct
class SehReaderConcept<STRUCT> {
	let ref ByValue<STRUCT>
	new (address UInt64) {
		// Always zero-fill cause its stack allocated
		// TODO Hexa: always zero-fill `= {0}` stack allocated in code gen until `@noZeroing`
		memset(ref.ref as! ArrayPointer<UInt8>, 0, sizeOf<STRUCT>()) // Zeroing

		// TODO ensure this does not overflow and bounds are correct
		if (address + sizeOf<STRUCT>()) >= upper or not probeForReadOkay(address, sizeOf<STRUCT>()) {
			// Cancel reading when its clearly tries to read engine memory
			serialPrintf("[sehReader] trying to read engine or bad memory %8\n", address)
		} else {
			// TODO use SEH-version of memory copy function
			tmemcpy(ref.ref as! ArrayPointer<UInt8>, address as! ConstArrayPointer<UInt8>, sizeOf<STRUCT>())
		}
	}
}

// TODO 16-bit ones should go via emulator instead of entry point
// like `if x16 { emu16(entry) } else entry()`
fun is64Exe(asset RamDiskAsset) {
	let ptr = asset.data as! ArrayPointer<UInt8>
	// TODO 32-bit 0x3C and must be within asset bounds -> read as pointer to a number
	let peHeader = ((ptr as! UInt64) + ptr[0x3C] + ptr[0x3C + 1] * 256) as! PeHeader
	let peOptionalHeader = ((peHeader as! UInt64) + sizeOf<PeHeader>()) as! Pe64OptionalHeader
	return peOptionalHeader.magic == 0x020B
}

